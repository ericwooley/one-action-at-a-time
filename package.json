{
  "name": "one-action-at-a-time",
  "version": "1.0.0",
  "private": true,
  "description": "A GitHub action that waits for other GitHub actions to complete",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "pack": "ncc build src/main.ts --out dist",
    "all": "npm run build && npm run pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Eric Wooley",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@typescript-eslint/parser": "8.64.0",
    "@vercel/ncc": "0.38.4",
    "eslint": "9.32.0",
    "js-yaml": "3.15.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
