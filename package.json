{
  "name": "one-action-at-a-time",
  "version": "1.0.0",
  "private": true,
  "description": "A GitHub action that waits for other GitHub actions to complete",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "pack": "ncc build",
    "all": "npm run build && npm run pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Eric Wooley",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^4.10.0",
    "@vercel/ncc": "^0.44.1",
    "js-yaml": "^3.14.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
